module

public import Mathlib.Logic.Relation
public import Mathlib.Data.Set.Finite.Basic
public import Mathlib.Basic.Real.Basic
public import Mathlib.Tactic.Linarith

/-!
# Chain clusters

For a real "distance" `d`, a set `S` and a radius `ρ`, the `ρ`-chain clusters of `S`
are the equivalence classes of the relation on `S` generated by `d x y < ρ`
.

We prove partition, separation, closure, an intrinsic
characterization, finiteness and locality.
-/

@[expose] public section

namespace FroehlichSpencer.Multiscale

variable {X : Type*}

/--
One chain step inside `S`: two points of `S` at distance `< ρ` .
-/
def chainStep (d : X → X → ℝ) (S : Set X) (ρ : ℝ) (x y : X) : Prop :=
  x ∈ S ∧ y ∈ S ∧ d x y < ρ

/--
The `ρ`-chain cluster of `x` in `S` ; empty if `x ∉ S`.
-/
def chainCluster (d : X → X → ℝ) (S : Set X) (ρ : ℝ) (x : X) : Set X :=
  {y | x ∈ S ∧ Relation.ReflTransGen (chainStep d S ρ) x y}

/-- The `ρ`-chain clusters of `S`. -/
def chainClusters (d : X → X → ℝ) (S : Set X) (ρ : ℝ) : Set (Set X) :=
  {C | ∃ x ∈ S, C = chainCluster d S ρ x}

/-- `diam C ≤ D` for the distance `d`. -/
def DiamLE (d : X → X → ℝ) (C : Set X) (D : ℝ) : Prop := ∀ a ∈ C, ∀ b ∈ C, d a b ≤ D

variable {d : X → X → ℝ} {S : Set X} {ρ : ℝ}

theorem mem_chainCluster_self {x : X} (hx : x ∈ S) : x ∈ chainCluster d S ρ x :=
  ⟨hx, Relation.ReflTransGen.refl⟩

theorem chainCluster_subset (x : X) : chainCluster d S ρ x ⊆ S := by
  rintro y ⟨hx, h⟩
  rcases Relation.ReflTransGen.cases_tail h with rfl | ⟨b, _, hb⟩
  · exact hx
  · exact hb.2.1

theorem mem_chainCluster_comm (hsymm : ∀ a b, d a b = d b a) {x y : X} :
    y ∈ chainCluster d S ρ x ↔ x ∈ chainCluster d S ρ y := by
  have hs : Std.Symm (chainStep d S ρ) :=
    ⟨fun a b ⟨ha, hb, h⟩ => ⟨hb, ha, by rwa [hsymm]⟩⟩
  constructor
  · intro h
    exact ⟨chainCluster_subset x h, (Relation.ReflTransGen.stdSymm.symm _ _ h.2)⟩
  · intro h
    exact ⟨chainCluster_subset y h, (Relation.ReflTransGen.stdSymm.symm _ _ h.2)⟩

theorem chainCluster_eq_of_mem (hsymm : ∀ a b, d a b = d b a) {x y : X}
    (hy : y ∈ chainCluster d S ρ x) : chainCluster d S ρ y = chainCluster d S ρ x := by
  have hyx : x ∈ chainCluster d S ρ y := (mem_chainCluster_comm hsymm).1 hy
  ext z
  constructor
  · intro hz
    exact ⟨hy.1, hy.2.trans hz.2⟩
  · intro hz
    exact ⟨hyx.1, hyx.2.trans hz.2⟩

theorem chainCluster_eq_or_disjoint (hsymm : ∀ a b, d a b = d b a) (x y : X) :
    chainCluster d S ρ x = chainCluster d S ρ y ∨
      Disjoint (chainCluster d S ρ x) (chainCluster d S ρ y) := by
  by_cases h : Disjoint (chainCluster d S ρ x) (chainCluster d S ρ y)
  · exact Or.inr h
  · left
    obtain ⟨z, hzx, hzy⟩ := Set.not_disjoint_iff.1 h
    rw [← chainCluster_eq_of_mem hsymm hzx, ← chainCluster_eq_of_mem hsymm hzy]

theorem mem_chainCluster_of_lt {x c y : X} (hc : c ∈ chainCluster d S ρ x) (hy : y ∈ S)
    (hcy : d c y < ρ) : y ∈ chainCluster d S ρ x :=
  ⟨hc.1, hc.2.tail ⟨chainCluster_subset x hc, hy, hcy⟩⟩

theorem le_of_mem_chainCluster_of_not_mem {x c y : X} (hc : c ∈ chainCluster d S ρ x)
    (hy : y ∈ S) (hy' : y ∉ chainCluster d S ρ x) : ρ ≤ d c y := by
  by_contra h
  exact hy' (mem_chainCluster_of_lt hc hy (not_le.1 h))

theorem eq_chainCluster_iff {C : Set X} {x : X} (hx : x ∈ C) :
    C = chainCluster d S ρ x ↔
      C ⊆ S ∧ (∀ c ∈ C, ∀ y ∈ S, d c y < ρ → y ∈ C) ∧
        ∀ c ∈ C, Relation.ReflTransGen (chainStep d C ρ) x c := by
  constructor
  · intro h
    subst h
    refine ⟨chainCluster_subset x, fun c hc y hy hcy => mem_chainCluster_of_lt hc hy hcy, ?_⟩
    intro c hc
    obtain ⟨hxS, hc⟩ := hc
    induction hc with
    | refl => exact Relation.ReflTransGen.refl
    | tail hab hbc ih =>
      rename_i b c'
      have hbmem : b ∈ chainCluster d S ρ x := ⟨hxS, hab⟩
      have hcmem : c' ∈ chainCluster d S ρ x := ⟨hxS, hab.tail hbc⟩
      exact ih.tail ⟨hbmem, hcmem, hbc.2.2⟩
  · rintro ⟨hCS, hcl, hch⟩
    ext y
    constructor
    · intro hy
      refine ⟨hCS hx, ?_⟩
      exact Relation.ReflTransGen.mono (fun a b (⟨ha, hb, h⟩ : chainStep d C ρ a b) =>
        (⟨hCS ha, hCS hb, h⟩ : chainStep d S ρ a b)) _ _ (hch y hy)
    · rintro ⟨_, h⟩
      induction h with
      | refl => exact hx
      | tail _ hbc ih => exact hcl _ ih _ hbc.2.1 hbc.2.2

theorem chainCluster_subset_ball {x : X} {D : ℝ} (hx : x ∈ S)
    (h : DiamLE d (chainCluster d S ρ x) D) : chainCluster d S ρ x ⊆ {y | d x y ≤ D} :=
  fun _ hy => h x (mem_chainCluster_self hx) _ hy

theorem chainCluster_eq_of_eqOn_ball
    (htri : ∀ a b c, d a b ≤ d a c + d c b) (hd0 : ∀ a, d a a = 0) (hρ : 0 < ρ) {S' : Set X}
    {x : X} {D : ℝ} (hx : x ∈ S)
    (hdiam : DiamLE d (chainCluster d S ρ x) D)
    (hSS' : ∀ y, d x y < D + ρ → (y ∈ S ↔ y ∈ S')) :
    chainCluster d S' ρ x = chainCluster d S ρ x := by
  have hball := chainCluster_subset_ball hx hdiam
  have hxC : x ∈ chainCluster d S ρ x := mem_chainCluster_self hx
  have hD : 0 ≤ D := by simpa [hd0 x] using hdiam x hxC x hxC
  have hxS' : x ∈ S' := (hSS' x (by rw [hd0 x]; linarith)).1 hx
  obtain ⟨_, _, hch⟩ := (eq_chainCluster_iff (d := d) (S := S) (ρ := ρ) hxC).1 rfl
  symm
  rw [eq_chainCluster_iff (d := d) (S := S') (ρ := ρ) hxC]
  refine ⟨fun c hc => (hSS' c ?_).1 (chainCluster_subset x hc), ?_, hch⟩
  · have := hball hc
    simp only [Set.mem_ofPred_eq] at this
    linarith
  · intro c hc y hy hcy
    have hcb : d x c ≤ D := hball hc
    have hyS : y ∈ S := (hSS' y (by linarith [htri x y c])).2 hy
    exact mem_chainCluster_of_lt hc hyS hcy

end FroehlichSpencer.Multiscale
