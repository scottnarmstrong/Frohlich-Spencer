/-! FS82 perimeter surface definition statement -/

@[expose] public section

open scoped BigOperators
open Filter

namespace FroehlichSpencer.FS82.Surface

/-- FS82 (2.6), first line: `⟨W(ℒ)⟩_Λ(β) = ∫ W(ℒ) dμ_β(θ_Λ)`. -/
noncomputable def wilsonLoopExpectation (R : RectBox4) (β : ℝ) (hβ : 0 < β)
    (loop : LatticeChain) : ℂ :=
  ∫ θ, wilsonLoopObservable R loop θ ∂primalVillainLaw R β hβ

end FroehlichSpencer.FS82.Surface

