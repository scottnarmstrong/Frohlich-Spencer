/-!
# Product measures on site potentials

Generic product-measure tools for real-valued configurations.

The setup is
motivated by the product probability space and bounded single-site density in
Fröhlich–Spencer (1983), equations (1.6)–(1.7) and (1.21), transcribed in
Fröhlich–Spencer (1983).

No model-specific object is defined here.
-/

@[expose] public section

open MeasureTheory MeasurableSpace Set
open scoped ENNReal

namespace FroehlichSpencer.Infra

section Configuration

variable {ι : Type*}

/-- The product probability measure for an i.i.d. real-valued configuration. -/
noncomputable abbrev productMeasure (μ : Measure ℝ) [IsProbabilityMeasure μ] : Measure (ι → ℝ) :=
  Measure.infinitePi (fun _ : ι => μ)

/-- The σ-algebra generated by the coordinates indexed by `S`. -/
abbrev localSigma (S : Set ι) : MeasurableSpace (ι → ℝ) :=
  MeasurableSpace.comap (fun v : ι → ℝ => fun i : S => v i) inferInstance

/-- The σ-algebra generated by the single site `x`. -/
abbrev siteSigma (x : ι) : MeasurableSpace (ι → ℝ) :=
  MeasurableSpace.comap (fun v : ι → ℝ => v x) inferInstance

/-- A set depends only on `S` when it is measurable for the σ-algebra of the restriction to `S`. -/
def DependsOn (S : Set ι) (A : Set (ι → ℝ)) : Prop := MeasurableSet[localSigma S] A

theorem localSigma_eq_iSup (S : Set ι) :
    localSigma S = ⨆ i ∈ S, siteSigma i := by
  calc
    localSigma S = ⨆ i : S, siteSigma (ι := ι) i.1 := by
      simpa [localSigma, siteSigma] using
        (MeasurableSpace.comap_process_pi
          (fun (i : S) (v : ι → ℝ) => v i.1))
    _ = ⨆ i ∈ S, siteSigma (ι := ι) i := by
      rw [iSup_subtype'']

theorem siteSigma_le (x : ι) : siteSigma x ≤ (inferInstance : MeasurableSpace (ι → ℝ)) := by
  change (inferInstance : MeasurableSpace ℝ).comap (fun v : ι → ℝ => v x) ≤
    (inferInstance : MeasurableSpace (ι → ℝ))
  exact (show Measurable (fun v : ι → ℝ => v x) from measurable_pi_apply x).comap_le

/-- If a measurable set is invariant under changes away from `S`, then it depends only on `S`. -/
theorem dependsOn_of_measurable_of_invariant {S : Set ι} {A : Set (ι → ℝ)}
    (hA : MeasurableSet A)
    (hInv : ∀ v w : ι → ℝ, (∀ i, i ∈ S → v i = w i) → (v ∈ A ↔ w ∈ A)) :
    DependsOn S A := by
  classical
  let extendOn : (S → ℝ) → (ι → ℝ) := fun u i => if hi : i ∈ S then u ⟨i, hi⟩ else 0
  have hsection : Measurable extendOn := by
    apply measurable_pi_iff.2
    intro i
    by_cases hi : i ∈ S
    · simpa [extendOn, hi] using (measurable_pi_apply (⟨i, hi⟩ : S))
    · simp [extendOn, hi]
  let C : Set (S → ℝ) := extendOn ⁻¹' A
  have hC : MeasurableSet C := hA.preimage hsection
  change MeasurableSet[MeasurableSpace.comap
    (fun v : ι → ℝ => fun i : S => v i) inferInstance] A
  rw [MeasurableSpace.measurableSet_comap]
  refine ⟨C, hC, ?_⟩
  ext v
  change (extendOn (fun i : S => v i) ∈ A) ↔ (v ∈ A)
  apply (hInv v (extendOn (fun i : S => v i)) _).symm
  intro i hi
  simp [extendOn, hi]

theorem coord_iIndep (μ : Measure ℝ) [IsProbabilityMeasure μ] :
    ProbabilityTheory.iIndep (siteSigma (ι := ι)) (productMeasure (ι := ι) μ) := by
  exact (ProbabilityTheory.iIndepFun_infinitePi
    (P := fun _ : ι => μ) (X := fun (_ : ι) (x : ℝ) => x)
    (fun _ => measurable_id)).iIndep

theorem localSigma_indep (μ : Measure ℝ) [IsProbabilityMeasure μ]
    {S T : Set ι} (hST : Disjoint S T) :
    ProbabilityTheory.Indep (localSigma S) (localSigma T) (productMeasure (ι := ι) μ) := by
  rw [localSigma_eq_iSup, localSigma_eq_iSup]
  exact ProbabilityTheory.indep_iSup_of_disjoint (fun i => siteSigma_le i)
    (coord_iIndep (ι := ι) μ) hST

theorem measure_inter_eq_mul_of_dependsOn (μ : Measure ℝ) [IsProbabilityMeasure μ]
    {S T : Set ι} {A B : Set (ι → ℝ)} (hST : Disjoint S T)
    (hA : DependsOn S A) (hB : DependsOn T B) :
    productMeasure (ι := ι) μ (A ∩ B) =
      productMeasure (ι := ι) μ A * productMeasure (ι := ι) μ B := by
  exact (ProbabilityTheory.Indep_iff _ _ _).mp
    (localSigma_indep (ι := ι) μ hST) A B hA hB

theorem localSigma_iUnion {κ : Type*} (S : κ → Set ι) (K : Set κ) :
    localSigma (⋃ k ∈ K, S k) = ⨆ k ∈ K, localSigma (S k) := by
  simp_rw [localSigma_eq_iSup]
  apply le_antisymm
  · apply iSup_le
    intro i
    apply iSup_le
    intro hi
    rcases Set.mem_iUnion.mp hi with ⟨k, hk⟩
    rcases Set.mem_iUnion.mp hk with ⟨hkK, hiS⟩
    exact le_iSup_of_le k (le_iSup_of_le hkK
      (le_iSup_of_le i (le_iSup_of_le hiS le_rfl)))
  · apply iSup_le
    intro k
    apply iSup_le
    intro hkK
    apply iSup_le
    intro i
    apply iSup_le
    intro hiS
    exact le_iSup_of_le i (le_iSup_of_le
      (Set.mem_iUnion.mpr ⟨k, Set.mem_iUnion.mpr ⟨hkK, hiS⟩⟩) le_rfl)

/-- Pairwise disjoint coordinate blocks generate mutually independent σ-algebras. -/
theorem localSigma_iIndep (μ : Measure ℝ) [IsProbabilityMeasure μ]
    {κ : Type*} (S : κ → Set ι) (hS : Pairwise fun i j => Disjoint (S i) (S j)) :
    ProbabilityTheory.iIndep (fun k => localSigma (S k)) (productMeasure (ι := ι) μ) := by
  rw [ProbabilityTheory.iIndep_iff]
  intro F A hA
  classical
  have hFormula : ∀ F : Finset κ, ∀ A : κ → Set (ι → ℝ),
      (∀ k, k ∈ F → DependsOn (S k) (A k)) →
      productMeasure (ι := ι) μ (⋂ k ∈ F, A k) =
        ∏ k ∈ F, productMeasure (ι := ι) μ (A k) := by
    intro F
    induction F using Finset.induction_on with
    | empty =>
        intro A hA
        simp
    | @insert k F hk ih =>
        intro A hA
        let U : Set ι := ⋃ j ∈ (F : Set κ), S j
        have hdisj : Disjoint U (S k) := by
          apply Set.disjoint_left.mpr
          intro x hxU hxk
          rcases Set.mem_iUnion.mp hxU with ⟨j, hj⟩
          rcases Set.mem_iUnion.mp hj with ⟨hjF, hxj⟩
          have hjk : j ≠ k := by
            intro hEq
            subst j
            exact hk hjF
          exact (Set.disjoint_left.mp (hS hjk)) hxj hxk
        have hind := localSigma_indep (ι := ι) μ hdisj
        have hUnion : localSigma U = ⨆ j ∈ (F : Set κ), localSigma (S j) := by
          exact localSigma_iUnion S (F : Set κ)
        have hprev : DependsOn U (⋂ j ∈ F, A j) := by
          change MeasurableSet[localSigma U] (⋂ j ∈ F, A j)
          rw [hUnion]
          apply MeasurableSet.biInter F.finite_toSet.countable
          intro j hj
          have hjle : localSigma (S j) ≤
              (⨆ l : κ, ⨆ hl : l ∈ (F : Set κ), localSigma (S l)) := by
            exact le_iSup_of_le j (le_iSup_of_le hj le_rfl)
          exact hjle (A j) (hA j (Finset.mem_insert_of_mem hj))
        have hkA : DependsOn (S k) (A k) := hA k (Finset.mem_insert_self k F)
        have hsplit : productMeasure (ι := ι) μ
              ((⋂ j ∈ F, A j) ∩ A k) =
            productMeasure (ι := ι) μ (⋂ j ∈ F, A j) *
              productMeasure (ι := ι) μ (A k) := by
          exact (ProbabilityTheory.Indep_iff _ _ _).mp hind _ _ hprev hkA
        have hset : (⋂ j ∈ insert k F, A j) = (⋂ j ∈ F, A j) ∩ A k := by
          ext v
          simp [and_comm]
        rw [hset, hsplit, ih A (fun j hj => hA j (Finset.mem_insert_of_mem hj)),
          Finset.prod_insert hk]
        exact mul_comm _ _
  exact hFormula F A hA

theorem measure_iInter_eq_prod_of_dependsOn_finset (μ : Measure ℝ)
    [IsProbabilityMeasure μ] {κ : Type*} [Fintype κ]
    (S : κ → Set ι) (hS : Pairwise fun i j => Disjoint (S i) (S j))
    (A : κ → Set (ι → ℝ)) (hA : ∀ k, DependsOn (S k) (A k)) :
    productMeasure (ι := ι) μ (⋂ k, A k) =
      ∏ k, productMeasure (ι := ι) μ (A k) := by
  exact (localSigma_iIndep (ι := ι) μ S hS).meas_iInter hA

end Configuration

section OneSite

variable {ι : Type*} [DecidableEq ι]

/-- Split a configuration into its value at `x` and its restriction to the other sites. -/
def siteSplit (x : ι) (v : ι → ℝ) : ℝ × ({i : ι // i ≠ x} → ℝ) :=
  (v x, fun i => v i.1)

/-- Reassemble a configuration from its value at `x` and its values away from `x`. -/
noncomputable def siteUnsplit (x : ι)
    (p : ℝ × ({i : ι // i ≠ x} → ℝ)) : ι → ℝ := by
  classical
  exact fun i => if hi : i = x then p.1 else p.2 ⟨i, hi⟩

omit [DecidableEq ι] in
theorem measurable_siteSplit (x : ι) : Measurable (siteSplit x) := by
  change Measurable (fun v : ι → ℝ => (v x, fun i : {i : ι // i ≠ x} => v i.1))
  apply (measurable_pi_apply x).prodMk
  apply measurable_pi_iff.2
  intro i
  exact measurable_pi_apply i.1

theorem measurable_siteUnsplit (x : ι) : Measurable (siteUnsplit x) := by
  classical
  apply measurable_pi_iff.2
  intro i
  by_cases hi : i = x
  · simpa [siteUnsplit, hi] using
      (measurable_fst : Measurable (fun p : ℝ × ({i : ι // i ≠ x} → ℝ) => p.1))
  · have heq : (fun p : ℝ × ({i : ι // i ≠ x} → ℝ) => siteUnsplit x p i) =
        fun p => p.2 ⟨i, hi⟩ := by
      funext p
      simp [siteUnsplit, hi]
    rw [heq]
    exact (measurable_pi_apply (⟨i, hi⟩ : {i : ι // i ≠ x})).comp measurable_snd

theorem siteUnsplit_siteSplit (x : ι) (v : ι → ℝ) :
    siteUnsplit x (siteSplit x v) = v := by
  classical
  funext i
  by_cases hi : i = x <;> simp [siteUnsplit, siteSplit, hi]

theorem siteSplit_siteUnsplit (x : ι) (p : ℝ × ({i : ι // i ≠ x} → ℝ)) :
    siteSplit x (siteUnsplit x p) = p := by
  classical
  cases p with
  | mk t w =>
      apply Prod.ext
      · simp [siteSplit, siteUnsplit]
      · funext i
        simp [siteSplit, siteUnsplit, i.2]

omit [DecidableEq ι] in
theorem siteSplit_map_productMeasure (μ : Measure ℝ) [IsProbabilityMeasure μ] (x : ι) :
    (productMeasure (ι := ι) μ).map (siteSplit x) =
      μ.prod (Measure.infinitePi (fun _ : {i : ι // i ≠ x} => μ)) := by
  let rest : (ι → ℝ) → ({i : ι // i ≠ x} → ℝ) := fun v i => v i.1
  have hsplit : ProbabilityTheory.IndepFun (fun v : ι → ℝ => v x) rest
      (productMeasure (ι := ι) μ) := by
    rw [ProbabilityTheory.IndepFun_iff_Indep]
    change ProbabilityTheory.Indep (siteSigma x) (localSigma {i : ι | i ≠ x})
      (productMeasure (ι := ι) μ)
    have hsingle : localSigma {i : ι | i = x} = siteSigma x := by
      rw [localSigma_eq_iSup]
      simp
    rw [← hsingle]
    exact localSigma_indep (ι := ι) μ
      (Set.disjoint_left.mpr (by intro i hi hni; exact hni hi))
  change (productMeasure (ι := ι) μ).map
      (fun v : ι → ℝ => (v x, fun i : {i : ι // i ≠ x} => v i.1)) = _
  have hmrest : Measurable rest := by
    apply measurable_pi_iff.2
    intro i
    exact measurable_pi_apply i.1
  rw [hsplit.map_prod_eq_prod_map_map
    (show AEMeasurable (fun v : ι → ℝ => v x) (productMeasure (ι := ι) μ) from
      (measurable_pi_apply x).aemeasurable) hmrest.aemeasurable]
  rw [Measure.infinitePi_map_eval]
  change μ.prod ((Measure.infinitePi (fun _ : ι => μ)).map
    ({i : ι | i ≠ x}.domRestrict)) =
      μ.prod (Measure.infinitePi (fun _ : {i : ι // i ≠ x} => μ))
  rw [Measure.infinitePi_map_restrict' (fun _ : ι => μ) (I := {i : ι | i ≠ x})]
  rfl

/-- Integrating a nonnegative measurable function over the product measure can be done by
integrating first over one coordinate, with all other coordinates held fixed. -/
theorem lintegral_productMeasure_update (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (x : ι) {f : (ι → ℝ) → ℝ≥0∞} (hf : Measurable f) :
    ∫⁻ v, f v ∂productMeasure (ι := ι) μ =
      ∫⁻ v, ∫⁻ t, f (Function.update v x t) ∂μ ∂productMeasure (ι := ι) μ := by
  let P : Measure (ι → ℝ) := productMeasure (ι := ι) μ
  let R : Measure ({i : ι // i ≠ x} → ℝ) :=
    Measure.infinitePi (fun _ : {i : ι // i ≠ x} => μ)
  let rest : (ι → ℝ) → ({i : ι // i ≠ x} → ℝ) := fun v i => v i.1
  let H : ({i : ι // i ≠ x} → ℝ) → ℝ≥0∞ := fun w =>
    ∫⁻ t, f (siteUnsplit x (t, w)) ∂μ
  change ∫⁻ v, f v ∂P =
    ∫⁻ v, ∫⁻ t, f (Function.update v x t) ∂μ ∂P
  have hsplit := siteSplit_map_productMeasure (ι := ι) μ x
  have hmap : P.map (siteSplit x) = μ.prod R := by
    simpa [P, R] using hsplit
  have hleft : ∫⁻ v, f v ∂P = ∫⁻ p, f (siteUnsplit x p) ∂(μ.prod R) := by
    calc
      ∫⁻ v, f v ∂P = ∫⁻ v, f (siteUnsplit x (siteSplit x v)) ∂P := by
        apply lintegral_congr_ae
        exact ae_of_all _ fun v => congrArg f (siteUnsplit_siteSplit x v).symm
      _ = ∫⁻ p, f (siteUnsplit x p) ∂P.map (siteSplit x) := by
        exact lintegral_comp (hf.comp (measurable_siteUnsplit x)) (measurable_siteSplit x)
      _ = ∫⁻ p, f (siteUnsplit x p) ∂(μ.prod R) := by rw [hmap]
  have hupdate (v : ι → ℝ) (t : ℝ) :
      Function.update v x t = siteUnsplit x (t, rest v) := by
    classical
    funext i
    by_cases hi : i = x <;> simp [Function.update, siteUnsplit, rest, hi]
  have hright :
      ∫⁻ v, ∫⁻ t, f (Function.update v x t) ∂μ ∂P =
        ∫⁻ v, H (rest v) ∂P := by
    apply lintegral_congr_ae
    exact ae_of_all _ fun v => by
      apply lintegral_congr_ae
      exact ae_of_all _ fun t => congrArg f (hupdate v t)
  have hHmeas : Measurable H := by
    change Measurable (fun w => ∫⁻ t, f (siteUnsplit x (t, w)) ∂μ)
    exact (hf.comp (measurable_siteUnsplit x)).lintegral_prod_left'
  have hright_map :
      ∫⁻ v, H (rest v) ∂P = ∫⁻ p, H p.2 ∂(μ.prod R) := by
    calc
      ∫⁻ v, H (rest v) ∂P = ∫⁻ v, H ((siteSplit x v).2) ∂P := rfl
      _ = ∫⁻ p, H p.2 ∂P.map (siteSplit x) :=
        lintegral_comp (hHmeas.comp measurable_snd) (measurable_siteSplit x)
      _ = ∫⁻ p, H p.2 ∂(μ.prod R) := by rw [hmap]
  have hprodH : ∫⁻ p, H p.2 ∂(μ.prod R) = ∫⁻ w, H w ∂R := by
    simpa using (lintegral_prod_mul (μ := μ) (ν := R)
      (f := fun _ : ℝ => (1 : ℝ≥0∞)) (g := H)
      measurable_const.aemeasurable hHmeas.aemeasurable)
  have hTonelli :
      ∫⁻ p, f (siteUnsplit x p) ∂(μ.prod R) =
        ∫⁻ w, H w ∂R := by
    simpa [H] using (lintegral_prod_symm _
      (hf.comp (measurable_siteUnsplit x)).aemeasurable)
  exact hleft.trans hTonelli |>.trans hprodH.symm |>.trans hright_map.symm |>.trans hright.symm

end OneSite

theorem measure_le_boundedDensity (μ : Measure ℝ) {g : ℝ → ℝ≥0∞}
    {ρ : ℝ≥0∞} (hμ : μ = volume.withDensity g)
    (hg : ∀ᵐ t ∂(volume : Measure ℝ), g t ≤ ρ) (s : Set ℝ) :
    μ s ≤ ρ * volume s := by
  rw [hμ, withDensity_apply']
  calc
    ∫⁻ t in s, g t ∂(volume : Measure ℝ) ≤ ∫⁻ t in s, ρ ∂(volume : Measure ℝ) := by
      apply setLIntegral_mono_ae (μ := (volume : Measure ℝ)) (g := fun _ => ρ)
      · exact measurable_const.aemeasurable
      · filter_upwards [hg] with t ht _
        exact ht
    _ = ρ * volume s := setLIntegral_const s ρ

theorem measure_Icc_le_boundedDensity (μ : Measure ℝ) {g : ℝ → ℝ≥0∞}
    {ρ : ℝ≥0∞} (hμ : μ = volume.withDensity g)
    (hg : ∀ᵐ t ∂(volume : Measure ℝ), g t ≤ ρ) (a b : ℝ) :
    μ (Set.Icc a b) ≤ ρ * ENNReal.ofReal (b - a) := by
  simpa only [Real.volume_Icc] using measure_le_boundedDensity μ hμ hg (Set.Icc a b)

/-- A single-site membership event has probability at most the density bound times a uniform
Lebesgue-volume bound for its sections. The event's measurability is an explicit premise. -/
theorem measure_singleSite_membership_le_boundedDensity {ι : Type*} [DecidableEq ι]
    (μ : Measure ℝ) [IsProbabilityMeasure μ] {g : ℝ → ℝ≥0∞} {ρ w : ℝ≥0∞}
    (hμ : μ = volume.withDensity g)
    (hg : ∀ᵐ t ∂(volume : Measure ℝ), g t ≤ ρ) (x : ι)
    (I : (ι → ℝ) → Set ℝ)
    (hI : ∀ v t, I (Function.update v x t) = I v)
    (hvol : ∀ v, volume (I v) ≤ w)
    (hEvent : MeasurableSet {v : ι → ℝ | v x ∈ I v}) :
    productMeasure (ι := ι) μ {v : ι → ℝ | v x ∈ I v} ≤ ρ * w := by
  classical
  let E : Set (ι → ℝ) := {v | v x ∈ I v}
  have hE : MeasurableSet E := hEvent
  have hIndicator : Measurable (E.indicator (fun _ : ι → ℝ => (1 : ℝ≥0∞))) :=
    measurable_const.indicator hE
  have hSection (v : ι → ℝ) : MeasurableSet (I v) := by
    have hpre : (Function.update v x) ⁻¹' E = I v := by
      ext t
      simp [E, hI v t]
    rw [← hpre]
    exact hE.preimage (measurable_update v (a := x))
  have hSectionIntegral (v : ι → ℝ) :
      ∫⁻ t, E.indicator (fun _ : ι → ℝ => (1 : ℝ≥0∞)) (Function.update v x t) ∂μ =
        μ (I v) := by
    have hfun : (fun t : ℝ =>
        E.indicator (fun _ : ι → ℝ => (1 : ℝ≥0∞)) (Function.update v x t)) =
        (I v).indicator (fun _ : ℝ => (1 : ℝ≥0∞)) := by
      have hmem (t : ℝ) : Function.update v x t ∈ E ↔ t ∈ I v := by
        change (Function.update v x t) x ∈ I (Function.update v x t) ↔ t ∈ I v
        rw [Function.update_self, hI v t]
      funext t
      rw [Set.indicator_apply, Set.indicator_apply]
      exact if_congr (hmem t) rfl rfl
    rw [hfun]
    exact lintegral_indicator_one (hSection v)
  have hBound (v : ι → ℝ) : μ (I v) ≤ ρ * w := by
    calc
      μ (I v) ≤ ρ * volume (I v) := measure_le_boundedDensity μ hμ hg (I v)
      _ ≤ ρ * w := by
        simpa [mul_comm] using (mul_le_mul_left (hvol v) ρ)
  calc
    productMeasure (ι := ι) μ E =
        ∫⁻ v, E.indicator (fun _ : ι → ℝ => (1 : ℝ≥0∞)) v
          ∂productMeasure (ι := ι) μ := (lintegral_indicator_one hE).symm
    _ = ∫⁻ v, ∫⁻ t,
          E.indicator (fun _ : ι → ℝ => (1 : ℝ≥0∞)) (Function.update v x t) ∂μ
          ∂productMeasure (ι := ι) μ :=
        lintegral_productMeasure_update μ x hIndicator
    _ ≤ ∫⁻ _v, ρ * w ∂productMeasure (ι := ι) μ := by
      apply lintegral_mono
      intro v
      change (∫⁻ t,
        E.indicator (fun _ : ι → ℝ => (1 : ℝ≥0∞)) (Function.update v x t) ∂μ) ≤ ρ * w
      rw [hSectionIntegral v]
      exact hBound v
    _ = ρ * w := by simp

end FroehlichSpencer.Infra

end
