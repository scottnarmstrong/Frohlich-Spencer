/-! # Certified merge ancestry for the Basic Lemma

The raw history records every selected pair.  This module adds the source
disjointness certificate preserved by a genuine iteration branch, and derives
connectedness of its original leaves in the input conflict graph.
-/

@[expose] public section

namespace FroehlichSpencer.BKT

open scoped BigOperators

/-- All original inputs that occur anywhere in a history, including the
partner discarded at a keep step. -/
def ChargeMergeHistory.allLeaves {L : ℕ} {boundary : SquareBoundary} {k : ℕ}
    {E : ChargeEnsemble L} {ρ : ChargeDensity L}
    (h : ChargeMergeHistory boundary k E ρ) : ChargeEnsemble L :=
  match h with
  | .leaf ρ _ => {ρ}
  | .add hρ hσ _ => hρ.allLeaves ∪ hσ.allLeaves
  | .sub hρ hσ _ => hρ.allLeaves ∪ hσ.allLeaves
  | .keepLeft hρ hσ _ => hρ.allLeaves ∪ hσ.allLeaves
  | .keepRight hρ hσ _ => hρ.allLeaves ∪ hσ.allLeaves

/-- A history is certified when the source inputs on its two sides are
disjoint at every binary operation. This rules out repeated leaves and hidden
cancellation in histories generated by the iteration. -/
inductive ChargeMergeHistory.Good {L : ℕ} {boundary : SquareBoundary} {k : ℕ}
    {E : ChargeEnsemble L} : {ρ : ChargeDensity L} →
      (h : ChargeMergeHistory boundary k E ρ) → Prop where
  | leaf (ρ : ChargeDensity L) (hρ : ρ ∈ E) :
      Good (.leaf ρ hρ)
  | add {ρ σ : ChargeDensity L}
      {hρ : ChargeMergeHistory boundary k E ρ}
      {hσ : ChargeMergeHistory boundary k E σ}
      (hconflict : densityDistance boundary L ρ σ ≤ 2 ^ k)
      (gρ : Good hρ) (gσ : Good hσ)
      (hdisj : Disjoint hρ.allLeaves hσ.allLeaves) :
      Good (.add hρ hσ hconflict)
  | sub {ρ σ : ChargeDensity L}
      {hρ : ChargeMergeHistory boundary k E ρ}
      {hσ : ChargeMergeHistory boundary k E σ}
      (hconflict : densityDistance boundary L ρ σ ≤ 2 ^ k)
      (gρ : Good hρ) (gσ : Good hσ)
      (hdisj : Disjoint hρ.allLeaves hσ.allLeaves) :
      Good (.sub hρ hσ hconflict)
  | keepLeft {ρ σ : ChargeDensity L}
      {hρ : ChargeMergeHistory boundary k E ρ}
      {hσ : ChargeMergeHistory boundary k E σ}
      (hconflict : densityDistance boundary L ρ σ ≤ 2 ^ k)
      (gρ : Good hρ) (gσ : Good hσ)
      (hdisj : Disjoint hρ.allLeaves hσ.allLeaves) :
      Good (.keepLeft hρ hσ hconflict)
  | keepRight {ρ σ : ChargeDensity L}
      {hρ : ChargeMergeHistory boundary k E ρ}
      {hσ : ChargeMergeHistory boundary k E σ}
      (hconflict : densityDistance boundary L ρ σ ≤ 2 ^ k)
      (gρ : Good hρ) (gσ : Good hσ)
      (hdisj : Disjoint hρ.allLeaves hσ.allLeaves) :
      Good (.keepRight hρ hσ hconflict)

/-- A merge history together with its no-repeated-source certificate. -/
structure CertifiedChargeMergeHistory {L : ℕ} (boundary : SquareBoundary) (k : ℕ)
    (E : ChargeEnsemble L) (ρ : ChargeDensity L) where
  history : ChargeMergeHistory boundary k E ρ
  good : history.Good

theorem ChargeMergeHistory.allLeaves_subset {L : ℕ}
    {boundary : SquareBoundary} {k : ℕ} {E : ChargeEnsemble L}
    {ρ : ChargeDensity L} (h : ChargeMergeHistory boundary k E ρ) :
    h.allLeaves ⊆ E := by
  induction h with
  | leaf ρ hρ => simpa [ChargeMergeHistory.allLeaves] using hρ
  | add hρ hσ hconflict ihρ ihσ => exact Finset.union_subset ihρ ihσ
  | sub hρ hσ hconflict ihρ ihσ => exact Finset.union_subset ihρ ihσ
  | keepLeft hρ hσ hconflict ihρ ihσ => exact Finset.union_subset ihρ ihσ
  | keepRight hρ hσ hconflict ihρ ihσ => exact Finset.union_subset ihρ ihσ

/-- The source resources supplied by a replacement history, extended by the
empty set off the replacement ensemble. -/
noncomputable def replacementHistoryResources {L : ℕ} {boundary : SquareBoundary}
    {k : ℕ} {E F : ChargeEnsemble L}
    (replace : ∀ ρ ∈ F, CertifiedChargeMergeHistory boundary k E ρ)
    (ρ : ChargeDensity L) : ChargeEnsemble L :=
  if hρ : ρ ∈ F then (replace ρ hρ).history.allLeaves else ∅

theorem ChargeMergeHistory.allLeaves_substitute_eq {L : ℕ}
    {boundary : SquareBoundary} {k : ℕ} {E F : ChargeEnsemble L}
    (replace : ∀ ρ ∈ F, CertifiedChargeMergeHistory boundary k E ρ)
    {ρ : ChargeDensity L} (h : ChargeMergeHistory boundary k F ρ) :
    (ChargeMergeHistory.substitute (fun a ha => (replace a ha).history) h).allLeaves =
      h.allLeaves.biUnion (replacementHistoryResources replace) := by
  classical
  induction h with
  | leaf ρ hρ =>
      simp [ChargeMergeHistory.substitute, ChargeMergeHistory.allLeaves,
        replacementHistoryResources, hρ]
  | add hρ hσ hconflict ihρ ihσ =>
      change (ChargeMergeHistory.substitute
        (fun a ha => (replace a ha).history) hρ).allLeaves ∪
        (ChargeMergeHistory.substitute
        (fun a ha => (replace a ha).history) hσ).allLeaves =
        (hρ.allLeaves ∪ hσ.allLeaves).biUnion
          (replacementHistoryResources replace)
      rw [ihρ, ihσ]
      ext x
      simp only [Finset.mem_union, Finset.mem_biUnion]
      constructor
      · rintro (⟨a, ha, hxa⟩ | ⟨a, ha, hxa⟩)
        · exact ⟨a, Or.inl ha, hxa⟩
        · exact ⟨a, Or.inr ha, hxa⟩
      · rintro ⟨a, ha | ha, hxa⟩
        · exact Or.inl ⟨a, ha, hxa⟩
        · exact Or.inr ⟨a, ha, hxa⟩
  | sub hρ hσ hconflict ihρ ihσ =>
      change (ChargeMergeHistory.substitute
        (fun a ha => (replace a ha).history) hρ).allLeaves ∪
        (ChargeMergeHistory.substitute
        (fun a ha => (replace a ha).history) hσ).allLeaves =
        (hρ.allLeaves ∪ hσ.allLeaves).biUnion
          (replacementHistoryResources replace)
      rw [ihρ, ihσ]
      ext x
      simp only [Finset.mem_union, Finset.mem_biUnion]
      constructor
      · rintro (⟨a, ha, hxa⟩ | ⟨a, ha, hxa⟩)
        · exact ⟨a, Or.inl ha, hxa⟩
        · exact ⟨a, Or.inr ha, hxa⟩
      · rintro ⟨a, ha | ha, hxa⟩
        · exact Or.inl ⟨a, ha, hxa⟩
        · exact Or.inr ⟨a, ha, hxa⟩
  | keepLeft hρ hσ hconflict ihρ ihσ =>
      change (ChargeMergeHistory.substitute
        (fun a ha => (replace a ha).history) hρ).allLeaves ∪
        (ChargeMergeHistory.substitute
        (fun a ha => (replace a ha).history) hσ).allLeaves =
        (hρ.allLeaves ∪ hσ.allLeaves).biUnion
          (replacementHistoryResources replace)
      rw [ihρ, ihσ]
      ext x
      simp only [Finset.mem_union, Finset.mem_biUnion]
      constructor
      · rintro (⟨a, ha, hxa⟩ | ⟨a, ha, hxa⟩)
        · exact ⟨a, Or.inl ha, hxa⟩
        · exact ⟨a, Or.inr ha, hxa⟩
      · rintro ⟨a, ha | ha, hxa⟩
        · exact Or.inl ⟨a, ha, hxa⟩
        · exact Or.inr ⟨a, ha, hxa⟩
  | keepRight hρ hσ hconflict ihρ ihσ =>
      change (ChargeMergeHistory.substitute
        (fun a ha => (replace a ha).history) hρ).allLeaves ∪
        (ChargeMergeHistory.substitute
        (fun a ha => (replace a ha).history) hσ).allLeaves =
        (hρ.allLeaves ∪ hσ.allLeaves).biUnion
          (replacementHistoryResources replace)
      rw [ihρ, ihσ]
      ext x
      simp only [Finset.mem_union, Finset.mem_biUnion]
      constructor
      · rintro (⟨a, ha, hxa⟩ | ⟨a, ha, hxa⟩)
        · exact ⟨a, Or.inl ha, hxa⟩
        · exact ⟨a, Or.inr ha, hxa⟩
      · rintro ⟨a, ha | ha, hxa⟩
        · exact Or.inl ⟨a, ha, hxa⟩
        · exact Or.inr ⟨a, ha, hxa⟩

private theorem substituted_history_resources_disjoint {L : ℕ}
    {boundary : SquareBoundary} {k : ℕ} {E F : ChargeEnsemble L}
    (replace : ∀ ρ ∈ F, CertifiedChargeMergeHistory boundary k E ρ)
    (hreplace : ∀ a (ha : a ∈ F) b (hb : b ∈ F), a ≠ b →
      Disjoint (replace a ha).history.allLeaves
        (replace b hb).history.allLeaves)
    {ρ σ : ChargeDensity L}
    (hρ : ChargeMergeHistory boundary k F ρ)
    (hσ : ChargeMergeHistory boundary k F σ)
    (hsource : Disjoint hρ.allLeaves hσ.allLeaves) :
    Disjoint
      (ChargeMergeHistory.substitute (fun a ha => (replace a ha).history) hρ).allLeaves
      (ChargeMergeHistory.substitute (fun a ha => (replace a ha).history) hσ).allLeaves := by
  classical
  rw [hρ.allLeaves_substitute_eq replace, hσ.allLeaves_substitute_eq replace]
  apply Finset.disjoint_left.mpr
  intro x hxρ hxσ
  obtain ⟨a, ha, hxa⟩ := Finset.mem_biUnion.mp hxρ
  obtain ⟨b, hb, hxb⟩ := Finset.mem_biUnion.mp hxσ
  have haF : a ∈ F := ChargeMergeHistory.allLeaves_subset hρ ha
  have hbF : b ∈ F := ChargeMergeHistory.allLeaves_subset hσ hb
  have hxa' : x ∈ (replace a haF).history.allLeaves := by
    simpa [replacementHistoryResources, haF] using hxa
  have hxb' : x ∈ (replace b hbF).history.allLeaves := by
    simpa [replacementHistoryResources, hbF] using hxb
  by_cases hab : a = b
  · subst b
    exact (Finset.disjoint_left.mp hsource) ha hb
  · exact (Finset.disjoint_left.mp (hreplace a haF b hbF hab)) hxa' hxb'

/-- A family of certified histories over an ensemble, with disjoint source
resources for distinct live factors. -/
structure CertifiedChargeHistoryFamily {L : ℕ} (boundary : SquareBoundary)
    (k : ℕ) (E F : ChargeEnsemble L) where
  history : ∀ ρ ∈ F, CertifiedChargeMergeHistory boundary k E ρ
  disjoint : ∀ ρ (hρ : ρ ∈ F) σ (hσ : σ ∈ F), ρ ≠ σ →
    Disjoint (history ρ hρ).history.allLeaves (history σ hσ).history.allLeaves

theorem ChargeMergeHistory.Good.substitute {L : ℕ}
    {boundary : SquareBoundary} {k : ℕ} {E F : ChargeEnsemble L}
    (replace : ∀ ρ ∈ F, CertifiedChargeMergeHistory boundary k E ρ)
    (hreplace : ∀ a (ha : a ∈ F) b (hb : b ∈ F), a ≠ b →
      Disjoint (replace a ha).history.allLeaves
        (replace b hb).history.allLeaves)
    {ρ : ChargeDensity L} (h : ChargeMergeHistory boundary k F ρ)
    (hg : h.Good) :
    (ChargeMergeHistory.substitute (fun a ha => (replace a ha).history) h).Good := by
  induction hg with
  | leaf ρ hρ =>
      simpa only [ChargeMergeHistory.substitute] using (replace ρ hρ).good
  | @add ρ σ hρ hσ hconflict hgρ hgσ hdisj ihρ ihσ =>
      exact .add hconflict ihρ ihσ
        (substituted_history_resources_disjoint replace hreplace hρ hσ hdisj)
  | @sub ρ σ hρ hσ hconflict hgρ hgσ hdisj ihρ ihσ =>
      exact .sub hconflict ihρ ihσ
        (substituted_history_resources_disjoint replace hreplace hρ hσ hdisj)
  | @keepLeft ρ σ hρ hσ hconflict hgρ hgσ hdisj ihρ ihσ =>
      exact .keepLeft hconflict ihρ ihσ
        (substituted_history_resources_disjoint replace hreplace hρ hσ hdisj)
  | @keepRight ρ σ hρ hσ hconflict hgρ hgσ hdisj ihρ ihσ =>
      exact .keepRight hconflict ihρ ihσ
        (substituted_history_resources_disjoint replace hreplace hρ hσ hdisj)

/-- Compose a branch's certified histories over an intermediate ensemble with
the certificates that express that ensemble in the original inputs. -/
def CertifiedChargeHistoryFamily.compose {L : ℕ} {boundary : SquareBoundary}
    {k : ℕ} {E F G : ChargeEnsemble L}
    (source : CertifiedChargeHistoryFamily boundary k F G)
    (replace : CertifiedChargeHistoryFamily boundary k E F) :
    CertifiedChargeHistoryFamily boundary k E G where
  history := fun ρ hρ =>
    { history := ChargeMergeHistory.substitute
        (fun a ha => (replace.history a ha).history)
        (source.history ρ hρ).history
      good := ChargeMergeHistory.Good.substitute
        (fun a ha => replace.history a ha)
        replace.disjoint (source.history ρ hρ).history
        (source.history ρ hρ).good }
  disjoint := by
    intro ρ hρ σ hσ hne
    exact substituted_history_resources_disjoint
      (fun a ha => replace.history a ha) replace.disjoint
      (source.history ρ hρ).history (source.history σ hσ).history
      (source.disjoint ρ hρ σ hσ hne)

theorem ChargeMergeHistory.leaves_subset_allLeaves {L : ℕ}
    {boundary : SquareBoundary} {k : ℕ} {E : ChargeEnsemble L}
    {ρ : ChargeDensity L} (h : ChargeMergeHistory boundary k E ρ) :
    h.leaves ⊆ h.allLeaves := by
  induction h with
  | leaf ρ hρ => simp [ChargeMergeHistory.leaves, ChargeMergeHistory.allLeaves]
  | add hρ hσ hconflict ihρ ihσ =>
      exact Finset.union_subset_union ihρ ihσ
  | sub hρ hσ hconflict ihρ ihσ =>
      exact Finset.union_subset_union ihρ ihσ
  | keepLeft hρ hσ hconflict ihρ ihσ =>
      intro a ha
      exact Finset.mem_union_left _ (ihρ ha)
  | keepRight hρ hσ hconflict ihρ ihσ =>
      intro a ha
      exact Finset.mem_union_right _ (ihσ ha)

private theorem chargeSupport_disjoint_of_source_disjoint {L : ℕ}
    (E S T : ChargeEnsemble L) (hE : IsBKTEnsemble E)
    (hS : S ⊆ E) (hT : T ⊆ E) (hST : Disjoint S T) :
    Disjoint (S.biUnion chargeSupport) (T.biUnion chargeSupport) := by
  classical
  apply Finset.disjoint_left.mpr
  intro x hxS hxT
  obtain ⟨ρ, hρS, hxρ⟩ := Finset.mem_biUnion.mp hxS
  obtain ⟨σ, hσT, hxσ⟩ := Finset.mem_biUnion.mp hxT
  have hρE := hS hρS
  have hσE := hT hσT
  have hρneσ : ρ ≠ σ := by
    intro heq
    subst σ
    exact (Finset.disjoint_left.mp hST) hρS hσT
  exact (Set.disjoint_left.mp (hE.2 ρ hρE σ hσE hρneσ))
    (by simpa [chargeSupport, Function.mem_support] using hxρ)
    (by simpa [chargeSupport, Function.mem_support] using hxσ)

private theorem chargeSupport_add_of_disjoint {L : ℕ}
    (ρ σ : ChargeDensity L)
    (hdisj : Disjoint (chargeSupport ρ) (chargeSupport σ)) :
    chargeSupport (ρ + σ) = chargeSupport ρ ∪ chargeSupport σ := by
  classical
  ext x
  simp only [chargeSupport, Finset.mem_filter, Finset.mem_univ, true_and,
    Pi.add_apply, Finset.mem_union]
  constructor
  · intro h
    by_cases hρ : ρ x = 0
    · right
      intro hσ
      exact h (by simp [hρ, hσ])
    · exact Or.inl hρ
  · rintro (hρ | hσ)
    · have hσ0 : σ x = 0 := by
        by_contra hσ0
        have hxρ : x ∈ chargeSupport ρ :=
          Finset.mem_filter.mpr ⟨Finset.mem_univ x, hρ⟩
        have hxσ : x ∈ chargeSupport σ :=
          Finset.mem_filter.mpr ⟨Finset.mem_univ x, hσ0⟩
        exact (Finset.disjoint_left.mp hdisj) hxρ hxσ
      simp [hρ, hσ0]
    · have hρ0 : ρ x = 0 := by
        by_contra hρ0
        have hxρ : x ∈ chargeSupport ρ :=
          Finset.mem_filter.mpr ⟨Finset.mem_univ x, hρ0⟩
        have hxσ : x ∈ chargeSupport σ :=
          Finset.mem_filter.mpr ⟨Finset.mem_univ x, hσ⟩
        exact (Finset.disjoint_left.mp hdisj) hxρ hxσ
      simp [hρ0, hσ]

private theorem chargeSupport_sub_of_disjoint {L : ℕ}
    (ρ σ : ChargeDensity L)
    (hdisj : Disjoint (chargeSupport ρ) (chargeSupport σ)) :
    chargeSupport (ρ - σ) = chargeSupport ρ ∪ chargeSupport σ := by
  classical
  ext x
  simp only [chargeSupport, Finset.mem_filter, Finset.mem_univ, true_and,
    Pi.sub_apply, Finset.mem_union]
  constructor
  · intro h
    by_cases hρ : ρ x = 0
    · right
      intro hσ
      exact h (by simp [hρ, hσ])
    · exact Or.inl hρ
  · rintro (hρ | hσ)
    · have hσ0 : σ x = 0 := by
        by_contra hσ0
        have hxρ : x ∈ chargeSupport ρ :=
          Finset.mem_filter.mpr ⟨Finset.mem_univ x, hρ⟩
        have hxσ : x ∈ chargeSupport σ :=
          Finset.mem_filter.mpr ⟨Finset.mem_univ x, hσ0⟩
        exact (Finset.disjoint_left.mp hdisj) hxρ hxσ
      simp [hρ, hσ0]
    · have hρ0 : ρ x = 0 := by
        by_contra hρ0
        have hxρ : x ∈ chargeSupport ρ :=
          Finset.mem_filter.mpr ⟨Finset.mem_univ x, hρ0⟩
        have hxσ : x ∈ chargeSupport σ :=
          Finset.mem_filter.mpr ⟨Finset.mem_univ x, hσ⟩
        exact (Finset.disjoint_left.mp hdisj) hxρ hxσ
      simp [hρ0, hσ]

/-- For a good history, the current factor is exactly the signed union of its
active source supports. In particular, no source leaf cancels or occurs twice. -/
theorem ChargeMergeHistory.good_support_eq_activeLeaves {L : ℕ}
    {boundary : SquareBoundary} {k : ℕ} {E : ChargeEnsemble L}
    {ρ : ChargeDensity L} (h : ChargeMergeHistory boundary k E ρ)
    (hg : h.Good) (hE : IsBKTEnsemble E) :
    chargeSupport ρ = h.leaves.biUnion chargeSupport := by
  induction hg with
  | leaf ρ hρ => simp [ChargeMergeHistory.leaves, chargeSupport]
  | @add ρ σ hρ hσ hconflict hgρ hgσ hdisj ihρ ihσ =>
      rw [chargeSupport_add_of_disjoint ρ σ ?_, ihρ, ihσ]
      · ext x
        simp only [ChargeMergeHistory.leaves, Finset.mem_biUnion,
          Finset.mem_union]
        constructor
        · rintro (⟨a, ha, hxa⟩ | ⟨a, ha, hxa⟩)
          · exact ⟨a, Or.inl ha, hxa⟩
          · exact ⟨a, Or.inr ha, hxa⟩
        · rintro ⟨a, ha | ha, hxa⟩
          · exact Or.inl ⟨a, ha, hxa⟩
          · exact Or.inr ⟨a, ha, hxa⟩
      · rw [ihρ, ihσ]
        have hactive : Disjoint hρ.leaves hσ.leaves := by
          apply Finset.disjoint_left.mpr
          intro a ha hb
          exact (Finset.disjoint_left.mp hdisj)
            (hρ.leaves_subset_allLeaves ha) (hσ.leaves_subset_allLeaves hb)
        exact chargeSupport_disjoint_of_source_disjoint E hρ.leaves hσ.leaves
          hE hρ.leaves_subset hσ.leaves_subset hactive
  | @sub ρ σ hρ hσ hconflict hgρ hgσ hdisj ihρ ihσ =>
      rw [chargeSupport_sub_of_disjoint ρ σ ?_, ihρ, ihσ]
      · ext x
        simp only [ChargeMergeHistory.leaves, Finset.mem_biUnion,
          Finset.mem_union]
        constructor
        · rintro (⟨a, ha, hxa⟩ | ⟨a, ha, hxa⟩)
          · exact ⟨a, Or.inl ha, hxa⟩
          · exact ⟨a, Or.inr ha, hxa⟩
        · rintro ⟨a, ha | ha, hxa⟩
          · exact Or.inl ⟨a, ha, hxa⟩
          · exact Or.inr ⟨a, ha, hxa⟩
      · rw [ihρ, ihσ]
        have hactive : Disjoint hρ.leaves hσ.leaves := by
          apply Finset.disjoint_left.mpr
          intro a ha hb
          exact (Finset.disjoint_left.mp hdisj)
            (hρ.leaves_subset_allLeaves ha) (hσ.leaves_subset_allLeaves hb)
        exact chargeSupport_disjoint_of_source_disjoint E hρ.leaves hσ.leaves
          hE hρ.leaves_subset hσ.leaves_subset hactive
  | @keepLeft ρ σ hρ hσ hconflict hgρ hgσ hdisj ihρ ihσ =>
      simpa [ChargeMergeHistory.leaves] using ihρ
  | @keepRight ρ σ hρ hσ hconflict hgρ hgσ hdisj ihρ ihσ =>
      simpa [ChargeMergeHistory.leaves] using ihσ

/-- A source conflict edge is symmetric by definition. Reflexive edges are
allowed; they make the relation robust under a coincident leaf witness. -/
def IsSourceConflictEdge (boundary : SquareBoundary) (L k : ℕ)
    (ρ σ : ChargeDensity L) : Prop :=
  densityDistance boundary L ρ σ ≤ 2 ^ k ∨
    densityDistance boundary L σ ρ ≤ 2 ^ k

inductive SourceConflictPath (boundary : SquareBoundary) (L k : ℕ) :
    ChargeDensity L → ChargeDensity L → Prop where
  | refl (ρ) : SourceConflictPath boundary L k ρ ρ
  | edge {ρ σ} : IsSourceConflictEdge boundary L k ρ σ →
      SourceConflictPath boundary L k ρ σ
  | trans {ρ σ τ} : SourceConflictPath boundary L k ρ σ →
      SourceConflictPath boundary L k σ τ → SourceConflictPath boundary L k ρ τ

private theorem exists_conflicting_active_leaves {L : ℕ}
    (boundary : SquareBoundary) (k : ℕ)
    (ρ σ : ChargeDensity L)
    (P Q : Finset (ChargeDensity L))
    (hρ : chargeSupport ρ = P.biUnion chargeSupport)
    (hσ : chargeSupport σ = Q.biUnion chargeSupport)
    (hP : P.Nonempty) (hQ : Q.Nonempty)
    (hPnonzero : ∀ a ∈ P, a ≠ 0) (hQnonzero : ∀ b ∈ Q, b ≠ 0)
    (hd : densityDistance boundary L ρ σ ≤ 2 ^ k) :
    ∃ a ∈ P, ∃ b ∈ Q, ∃ x ∈ chargeSupport a, ∃ y ∈ chargeSupport b,
      latticeDistance boundary L x y ≤ 2 ^ k := by
  classical
  have hρsupp : (chargeSupport ρ).Nonempty := by
    rw [hρ]
    obtain ⟨a, ha⟩ := hP
    obtain ⟨x, hx⟩ := exists_coordinate_ne_zero a (hPnonzero a ha)
    exact ⟨x, Finset.mem_biUnion.mpr ⟨a, ha, by simp [chargeSupport, hx]⟩⟩
  have hσsupp : (chargeSupport σ).Nonempty := by
    rw [hσ]
    obtain ⟨b, hb⟩ := hQ
    obtain ⟨x, hx⟩ := exists_coordinate_ne_zero b (hQnonzero b hb)
    exact ⟨x, Finset.mem_biUnion.mpr ⟨b, hb, by simp [chargeSupport, hx]⟩⟩
  have hprod : ((chargeSupport ρ).product (chargeSupport σ)).Nonempty := by
    obtain ⟨x, hx⟩ := hρsupp
    obtain ⟨y, hy⟩ := hσsupp
    exact ⟨(x, y), Finset.mem_product.mpr ⟨hx, hy⟩⟩
  let image := ((chargeSupport ρ).product (chargeSupport σ)).image
    (fun p => latticeDistance boundary L p.1 p.2)
  have himage : image.Nonempty := Finset.image_nonempty.mpr hprod
  have hmin_le : image.min' himage ≤ 2 ^ k := by
    change (if h : ((chargeSupport ρ).product (chargeSupport σ)).Nonempty then
      (((chargeSupport ρ).product (chargeSupport σ)).image
        (fun p => latticeDistance boundary L p.1 p.2)).min'
          (Finset.image_nonempty.mpr h) else 0) ≤ 2 ^ k at hd
    rw [dite_eq_left hprod] at hd
    exact hd
  have hmin_mem : image.min' himage ∈ image := Finset.min'_mem image himage
  obtain ⟨p, hp, hdistEq⟩ := Finset.mem_image.mp hmin_mem
  have hpProd := Finset.mem_product.mp hp
  let x := p.1
  let y := p.2
  have hx : x ∈ chargeSupport ρ := hpProd.1
  have hy : y ∈ chargeSupport σ := hpProd.2
  rw [hρ] at hx
  rw [hσ] at hy
  obtain ⟨a, ha, hxa⟩ := Finset.mem_biUnion.mp hx
  obtain ⟨b, hb, hyb⟩ := Finset.mem_biUnion.mp hy
  have hdist : latticeDistance boundary L x y ≤ 2 ^ k := by
    change latticeDistance boundary L p.1 p.2 ≤ 2 ^ k
    rw [hdistEq]
    simpa [image] using hmin_le
  exact ⟨a, ha, b, hb, x, hxa, y, hyb, hdist⟩

/-- The source leaves under any certified history form a connected set in the
conflict graph on the original ensemble. A selected conflict between current
factors lifts through their signed, disjoint support unions to an edge between
original input leaves. -/
theorem ChargeMergeHistory.good_sourceConnected {L : ℕ}
    {boundary : SquareBoundary} {k : ℕ} {E : ChargeEnsemble L}
    {ρ : ChargeDensity L} (h : ChargeMergeHistory boundary k E ρ)
    (hg : h.Good) (hE : IsBKTEnsemble E) :
    ∀ a ∈ h.allLeaves, ∀ b ∈ h.allLeaves,
      SourceConflictPath boundary L k a b := by
  induction hg with
  | leaf ρ hρ =>
      intro a ha b hb
      simp [ChargeMergeHistory.allLeaves] at ha hb
      subst a
      subst b
      exact .refl ρ
  | @add ρ σ hρ hσ hconflict hgρ hgσ hdisj ihρ ihσ =>
      have hρeq := hρ.good_support_eq_activeLeaves hgρ hE
      have hσeq := hσ.good_support_eq_activeLeaves hgσ hE
      have hρactive := hρ.leaves_nonempty
      have hσactive := hσ.leaves_nonempty
      obtain ⟨a₀, ha₀, b₀, hb₀, x₀, hx₀, y₀, hy₀, hxy₀⟩ :=
        exists_conflicting_active_leaves boundary k ρ σ hρ.leaves hσ.leaves
          hρeq hσeq hρactive hσactive
          (by intro a ha; exact hE.1 a (hρ.allLeaves_subset (hρ.leaves_subset_allLeaves ha)))
          (by intro b hb; exact hE.1 b (hσ.allLeaves_subset (hσ.leaves_subset_allLeaves hb)))
          hconflict
      intro a ha b hb
      simp only [ChargeMergeHistory.allLeaves, Finset.mem_union] at ha hb
      rcases ha with ha | ha <;> rcases hb with hb | hb
      · exact ihρ a ha b hb
      · exact .trans (ihρ a ha a₀ (hρ.leaves_subset_allLeaves ha₀))
          (.trans (.edge (Or.inl (by
            calc densityDistance boundary L a₀ b₀ ≤ latticeDistance boundary L x₀ y₀ :=
                squareDistance_le_latticeDistance_of_mem boundary L
                  (chargeSupport a₀) (chargeSupport b₀) x₀ y₀ hx₀ hy₀
              _ ≤ 2 ^ k := hxy₀)))
            (ihσ b₀ (hσ.leaves_subset_allLeaves hb₀) b hb))
      · exact .trans (ihσ a ha b₀ (hσ.leaves_subset_allLeaves hb₀))
          (.trans (.edge (Or.inr (by
            calc densityDistance boundary L a₀ b₀ ≤ latticeDistance boundary L x₀ y₀ :=
                squareDistance_le_latticeDistance_of_mem boundary L
                  (chargeSupport a₀) (chargeSupport b₀) x₀ y₀ hx₀ hy₀
              _ ≤ 2 ^ k := hxy₀)))
            (ihρ a₀ (hρ.leaves_subset_allLeaves ha₀) b hb))
      · exact ihσ a ha b hb
  | @sub ρ σ hρ hσ hconflict hgρ hgσ hdisj ihρ ihσ =>
      have hρeq := hρ.good_support_eq_activeLeaves hgρ hE
      have hσeq := hσ.good_support_eq_activeLeaves hgσ hE
      have hρactive := hρ.leaves_nonempty
      have hσactive := hσ.leaves_nonempty
      obtain ⟨a₀, ha₀, b₀, hb₀, x₀, hx₀, y₀, hy₀, hxy₀⟩ :=
        exists_conflicting_active_leaves boundary k ρ σ hρ.leaves hσ.leaves
          hρeq hσeq hρactive hσactive
          (by intro a ha; exact hE.1 a (hρ.allLeaves_subset (hρ.leaves_subset_allLeaves ha)))
          (by intro b hb; exact hE.1 b (hσ.allLeaves_subset (hσ.leaves_subset_allLeaves hb)))
          hconflict
      intro a ha b hb
      simp only [ChargeMergeHistory.allLeaves, Finset.mem_union] at ha hb
      rcases ha with ha | ha <;> rcases hb with hb | hb
      · exact ihρ a ha b hb
      · exact .trans (ihρ a ha a₀ (hρ.leaves_subset_allLeaves ha₀))
          (.trans (.edge (Or.inl (by
            calc densityDistance boundary L a₀ b₀ ≤ latticeDistance boundary L x₀ y₀ :=
                squareDistance_le_latticeDistance_of_mem boundary L
                  (chargeSupport a₀) (chargeSupport b₀) x₀ y₀ hx₀ hy₀
              _ ≤ 2 ^ k := hxy₀)))
            (ihσ b₀ (hσ.leaves_subset_allLeaves hb₀) b hb))
      · exact .trans (ihσ a ha b₀ (hσ.leaves_subset_allLeaves hb₀))
          (.trans (.edge (Or.inr (by
            calc densityDistance boundary L a₀ b₀ ≤ latticeDistance boundary L x₀ y₀ :=
                squareDistance_le_latticeDistance_of_mem boundary L
                  (chargeSupport a₀) (chargeSupport b₀) x₀ y₀ hx₀ hy₀
              _ ≤ 2 ^ k := hxy₀)))
            (ihρ a₀ (hρ.leaves_subset_allLeaves ha₀) b hb))
      · exact ihσ a ha b hb
  | @keepLeft ρ σ hρ hσ hconflict hgρ hgσ hdisj ihρ ihσ =>
      have hρeq := hρ.good_support_eq_activeLeaves hgρ hE
      have hσeq := hσ.good_support_eq_activeLeaves hgσ hE
      obtain ⟨a₀, ha₀, b₀, hb₀, x₀, hx₀, y₀, hy₀, hxy₀⟩ :=
        exists_conflicting_active_leaves boundary k ρ σ hρ.leaves hσ.leaves
          hρeq hσeq hρ.leaves_nonempty hσ.leaves_nonempty
          (by intro a ha; exact hE.1 a (hρ.allLeaves_subset (hρ.leaves_subset_allLeaves ha)))
          (by intro b hb; exact hE.1 b (hσ.allLeaves_subset (hσ.leaves_subset_allLeaves hb)))
          hconflict
      intro a ha b hb
      simp only [ChargeMergeHistory.allLeaves, Finset.mem_union] at ha hb
      rcases ha with ha | ha <;> rcases hb with hb | hb
      · exact ihρ a ha b hb
      · exact .trans (ihρ a ha a₀ (hρ.leaves_subset_allLeaves ha₀))
          (.trans (.edge (Or.inl (by
            calc densityDistance boundary L a₀ b₀ ≤ latticeDistance boundary L x₀ y₀ :=
                squareDistance_le_latticeDistance_of_mem boundary L
                  (chargeSupport a₀) (chargeSupport b₀) x₀ y₀ hx₀ hy₀
              _ ≤ 2 ^ k := hxy₀)))
            (ihσ b₀ (hσ.leaves_subset_allLeaves hb₀) b hb))
      · exact .trans (ihσ a ha b₀ (hσ.leaves_subset_allLeaves hb₀))
          (.trans (.edge (Or.inr (by
            calc densityDistance boundary L a₀ b₀ ≤ latticeDistance boundary L x₀ y₀ :=
                squareDistance_le_latticeDistance_of_mem boundary L
                  (chargeSupport a₀) (chargeSupport b₀) x₀ y₀ hx₀ hy₀
              _ ≤ 2 ^ k := hxy₀)))
            (ihρ a₀ (hρ.leaves_subset_allLeaves ha₀) b hb))
      · exact ihσ a ha b hb
  | @keepRight ρ σ hρ hσ hconflict hgρ hgσ hdisj ihρ ihσ =>
      have hρeq := hρ.good_support_eq_activeLeaves hgρ hE
      have hσeq := hσ.good_support_eq_activeLeaves hgσ hE
      obtain ⟨a₀, ha₀, b₀, hb₀, x₀, hx₀, y₀, hy₀, hxy₀⟩ :=
        exists_conflicting_active_leaves boundary k ρ σ hρ.leaves hσ.leaves
          hρeq hσeq hρ.leaves_nonempty hσ.leaves_nonempty
          (by intro a ha; exact hE.1 a (hρ.allLeaves_subset (hρ.leaves_subset_allLeaves ha)))
          (by intro b hb; exact hE.1 b (hσ.allLeaves_subset (hσ.leaves_subset_allLeaves hb)))
          hconflict
      intro a ha b hb
      simp only [ChargeMergeHistory.allLeaves, Finset.mem_union] at ha hb
      rcases ha with ha | ha <;> rcases hb with hb | hb
      · exact ihρ a ha b hb
      · exact .trans (ihρ a ha a₀ (hρ.leaves_subset_allLeaves ha₀))
          (.trans (.edge (Or.inl (by
            calc densityDistance boundary L a₀ b₀ ≤ latticeDistance boundary L x₀ y₀ :=
                squareDistance_le_latticeDistance_of_mem boundary L
                  (chargeSupport a₀) (chargeSupport b₀) x₀ y₀ hx₀ hy₀
              _ ≤ 2 ^ k := hxy₀)))
            (ihσ b₀ (hσ.leaves_subset_allLeaves hb₀) b hb))
      · exact .trans (ihσ a ha b₀ (hσ.leaves_subset_allLeaves hb₀))
          (.trans (.edge (Or.inr (by
            calc densityDistance boundary L a₀ b₀ ≤ latticeDistance boundary L x₀ y₀ :=
                squareDistance_le_latticeDistance_of_mem boundary L
                  (chargeSupport a₀) (chargeSupport b₀) x₀ y₀ hx₀ hy₀
              _ ≤ 2 ^ k := hxy₀)))
            (ihρ a₀ (hρ.leaves_subset_allLeaves ha₀) b hb))
      · exact ihσ a ha b hb

/-- Symmetry of the finite-box graph metric. -/
theorem latticeDistance_comm (boundary : SquareBoundary) (L : ℕ)
    (x y : Fin L × Fin L) :
    latticeDistance boundary L x y = latticeDistance boundary L y x := by
  cases boundary <;> simp [latticeDistance, SimpleGraph.dist_comm]

/-- A site in an active source leaf remains in the current factor's support. -/
theorem ChargeMergeHistory.good_site_mem_current {L : ℕ}
    {boundary : SquareBoundary} {k : ℕ} {E : ChargeEnsemble L}
    {ρ : ChargeDensity L} (h : ChargeMergeHistory boundary k E ρ)
    (hg : h.Good) (hE : IsBKTEnsemble E)
    {a : ChargeDensity L} (ha : a ∈ h.leaves)
    {x : Fin L × Fin L} (hx : x ∈ chargeSupport a) :
    x ∈ chargeSupport ρ := by
  rw [h.good_support_eq_activeLeaves hg hE]
  exact Finset.mem_biUnion.mpr ⟨a, ha, hx⟩


theorem ChargeMergeHistory.good_activeLeaves_card_eq_mergeCount_add_one {L : ℕ}
    {boundary : SquareBoundary} {k : ℕ} {E : ChargeEnsemble L}
    {ρ : ChargeDensity L} (h : ChargeMergeHistory boundary k E ρ)
    (hg : h.Good) : h.leaves.card = h.mergeCount + 1 := by
  induction hg with
  | leaf ρ hρ => simp [ChargeMergeHistory.leaves, ChargeMergeHistory.mergeCount]
  | @add ρ σ hρ hσ hconflict hgρ hgσ hdisj ihρ ihσ =>
      have hdisjLeaves : Disjoint hρ.leaves hσ.leaves := by
        apply Finset.disjoint_left.mpr
        intro a ha hb
        exact (Finset.disjoint_left.mp hdisj)
          (hρ.leaves_subset_allLeaves ha) (hσ.leaves_subset_allLeaves hb)
      rw [ChargeMergeHistory.leaves, Finset.card_union_of_disjoint hdisjLeaves,
        ChargeMergeHistory.mergeCount, ihρ, ihσ]
      omega
  | @sub ρ σ hρ hσ hconflict hgρ hgσ hdisj ihρ ihσ =>
      have hdisjLeaves : Disjoint hρ.leaves hσ.leaves := by
        apply Finset.disjoint_left.mpr
        intro a ha hb
        exact (Finset.disjoint_left.mp hdisj)
          (hρ.leaves_subset_allLeaves ha) (hσ.leaves_subset_allLeaves hb)
      rw [ChargeMergeHistory.leaves, Finset.card_union_of_disjoint hdisjLeaves,
        ChargeMergeHistory.mergeCount, ihρ, ihσ]
      omega
  | @keepLeft ρ σ hρ hσ hconflict hgρ hgσ hdisj ihρ ihσ =>
      simpa [ChargeMergeHistory.leaves, ChargeMergeHistory.mergeCount] using ihρ
  | @keepRight ρ σ hρ hσ hconflict hgρ hgσ hdisj ihρ ihσ =>
      simpa [ChargeMergeHistory.leaves, ChargeMergeHistory.mergeCount] using ihσ

/-- Each keep event can be charged to a distinct original input outside the
active lineage. Site witnesses show that each charged input is within scale
distance of the final factor. -/
theorem ChargeMergeHistory.exists_good_keepChargeSet {L : ℕ}
    {boundary : SquareBoundary} {k : ℕ} {E : ChargeEnsemble L}
    {ρ : ChargeDensity L} (h : ChargeMergeHistory boundary k E ρ)
    (hg : h.Good) (hE : IsBKTEnsemble E) :
    ∃ H : ChargeEnsemble L,
      H ⊆ h.allLeaves ∧ Disjoint H h.leaves ∧ H.card = h.keepCount ∧
      ∀ q ∈ H, ∃ x ∈ chargeSupport q, ∃ y ∈ chargeSupport ρ,
        latticeDistance boundary L x y ≤ 2 ^ k := by
  induction hg generalizing hE with
  | leaf ρ hρ =>
      refine ⟨∅, ?_, ?_, ?_, ?_⟩
      · simp
      · simp
      · simp [ChargeMergeHistory.keepCount]
      · simp
  | @add ρ σ hρ hσ hconflict hgρ hgσ hdisj ihρ ihσ =>
      obtain ⟨Hρ, hρsub, hρdisj, hρcard, hρnear⟩ := ihρ hE
      obtain ⟨Hσ, hσsub, hσdisj, hσcard, hσnear⟩ := ihσ hE
      have hHdisj : Disjoint Hρ Hσ := by
        apply Finset.disjoint_left.mpr
        intro a ha hb
        exact (Finset.disjoint_left.mp hdisj) (hρsub ha) (hσsub hb)
      have hparentGood : (ChargeMergeHistory.add hρ hσ hconflict).Good :=
        .add hconflict hgρ hgσ hdisj
      have hparentSupport :=
        (ChargeMergeHistory.add hρ hσ hconflict).good_support_eq_activeLeaves
          hparentGood hE
      have hρSupport := hρ.good_support_eq_activeLeaves hgρ hE
      have hσSupport := hσ.good_support_eq_activeLeaves hgσ hE
      refine ⟨Hρ ∪ Hσ, ?_, ?_, ?_, ?_⟩
      · intro a ha
        simp only [Finset.mem_union] at ha
        rcases ha with ha | ha
        · exact Finset.mem_union_left _ (hρsub ha)
        · exact Finset.mem_union_right _ (hσsub ha)
      · apply Finset.disjoint_left.mpr
        intro a haH haP
        simp only [Finset.mem_union] at haH haP
        simp only [ChargeMergeHistory.leaves, Finset.mem_union] at haP
        rcases haH with haρ | haσ
        · rcases haP with haPρ | haPσ
          · exact (Finset.disjoint_left.mp hρdisj) haρ haPρ
          · exact (Finset.disjoint_left.mp hdisj)
              (hρsub haρ) (hσ.leaves_subset_allLeaves haPσ)
        · rcases haP with haPρ | haPσ
          · exact (Finset.disjoint_left.mp hdisj.symm)
              (hσsub haσ) (hρ.leaves_subset_allLeaves haPρ)
          · exact (Finset.disjoint_left.mp hσdisj) haσ haPσ
      · rw [Finset.card_union_of_disjoint hHdisj,
          ChargeMergeHistory.keepCount, hρcard, hσcard]
      · intro q hq
        simp only [Finset.mem_union] at hq
        rcases hq with hqρ | hqσ
        · obtain ⟨x, hx, y, hy, hxy⟩ := hρnear q hqρ
          rw [hρSupport] at hy
          obtain ⟨a, ha, hya⟩ := Finset.mem_biUnion.mp hy
          have hyaParent : y ∈ chargeSupport (ρ + σ) := by
            rw [hparentSupport]
            exact Finset.mem_biUnion.mpr
              ⟨a, by simp [ChargeMergeHistory.leaves, ha], hya⟩
          exact ⟨x, hx, y, hyaParent, hxy⟩
        · obtain ⟨x, hx, y, hy, hxy⟩ := hσnear q hqσ
          rw [hσSupport] at hy
          obtain ⟨a, ha, hya⟩ := Finset.mem_biUnion.mp hy
          have hyaParent : y ∈ chargeSupport (ρ + σ) := by
            rw [hparentSupport]
            exact Finset.mem_biUnion.mpr
              ⟨a, by simp [ChargeMergeHistory.leaves, ha], hya⟩
          exact ⟨x, hx, y, hyaParent, hxy⟩
  | @sub ρ σ hρ hσ hconflict hgρ hgσ hdisj ihρ ihσ =>
      obtain ⟨Hρ, hρsub, hρdisj, hρcard, hρnear⟩ := ihρ hE
      obtain ⟨Hσ, hσsub, hσdisj, hσcard, hσnear⟩ := ihσ hE
      have hHdisj : Disjoint Hρ Hσ := by
        apply Finset.disjoint_left.mpr
        intro a ha hb
        exact (Finset.disjoint_left.mp hdisj) (hρsub ha) (hσsub hb)
      have hparentGood : (ChargeMergeHistory.sub hρ hσ hconflict).Good :=
        .sub hconflict hgρ hgσ hdisj
      have hparentSupport :=
        (ChargeMergeHistory.sub hρ hσ hconflict).good_support_eq_activeLeaves
          hparentGood hE
      have hρSupport := hρ.good_support_eq_activeLeaves hgρ hE
      have hσSupport := hσ.good_support_eq_activeLeaves hgσ hE
      refine ⟨Hρ ∪ Hσ, ?_, ?_, ?_, ?_⟩
      · intro a ha
        simp only [Finset.mem_union] at ha
        rcases ha with ha | ha
        · exact Finset.mem_union_left _ (hρsub ha)
        · exact Finset.mem_union_right _ (hσsub ha)
      · apply Finset.disjoint_left.mpr
        intro a haH haP
        simp only [Finset.mem_union] at haH haP
        simp only [ChargeMergeHistory.leaves, Finset.mem_union] at haP
        rcases haH with haρ | haσ
        · rcases haP with haPρ | haPσ
          · exact (Finset.disjoint_left.mp hρdisj) haρ haPρ
          · exact (Finset.disjoint_left.mp hdisj)
              (hρsub haρ) (hσ.leaves_subset_allLeaves haPσ)
        · rcases haP with haPρ | haPσ
          · exact (Finset.disjoint_left.mp hdisj.symm)
              (hσsub haσ) (hρ.leaves_subset_allLeaves haPρ)
          · exact (Finset.disjoint_left.mp hσdisj) haσ haPσ
      · rw [Finset.card_union_of_disjoint hHdisj,
          ChargeMergeHistory.keepCount, hρcard, hσcard]
      · intro q hq
        simp only [Finset.mem_union] at hq
        rcases hq with hqρ | hqσ
        · obtain ⟨x, hx, y, hy, hxy⟩ := hρnear q hqρ
          rw [hρSupport] at hy
          obtain ⟨a, ha, hya⟩ := Finset.mem_biUnion.mp hy
          have hyaParent : y ∈ chargeSupport (ρ - σ) := by
            rw [hparentSupport]
            exact Finset.mem_biUnion.mpr
              ⟨a, by simp [ChargeMergeHistory.leaves, ha], hya⟩
          exact ⟨x, hx, y, hyaParent, hxy⟩
        · obtain ⟨x, hx, y, hy, hxy⟩ := hσnear q hqσ
          rw [hσSupport] at hy
          obtain ⟨a, ha, hya⟩ := Finset.mem_biUnion.mp hy
          have hyaParent : y ∈ chargeSupport (ρ - σ) := by
            rw [hparentSupport]
            exact Finset.mem_biUnion.mpr
              ⟨a, by simp [ChargeMergeHistory.leaves, ha], hya⟩
          exact ⟨x, hx, y, hyaParent, hxy⟩
  | @keepLeft ρ σ hρ hσ hconflict hgρ hgσ hdisj ihρ ihσ =>
      obtain ⟨Hρ, hρsub, hρdisj, hρcard, hρnear⟩ := ihρ hE
      have hρSupport := hρ.good_support_eq_activeLeaves hgρ hE
      have hσSupport := hσ.good_support_eq_activeLeaves hgσ hE
      obtain ⟨a, ha, b, hb, x, hx, y, hy, hxy⟩ :=
        exists_conflicting_active_leaves boundary k ρ σ hρ.leaves hσ.leaves
          hρSupport hσSupport hρ.leaves_nonempty hσ.leaves_nonempty
          (by intro q hq; exact hE.1 q (hρ.allLeaves_subset
            (hρ.leaves_subset_allLeaves hq)))
          (by intro q hq; exact hE.1 q (hσ.allLeaves_subset
            (hσ.leaves_subset_allLeaves hq))) hconflict
      have hparentGood : (ChargeMergeHistory.keepLeft hρ hσ hconflict).Good :=
        .keepLeft hconflict hgρ hgσ hdisj
      have hparentSupport :=
        (ChargeMergeHistory.keepLeft hρ hσ hconflict).good_support_eq_activeLeaves
          hparentGood hE
      have hb_not_hρ : b ∉ hρ.leaves := by
        intro hbρ
        exact (Finset.disjoint_left.mp hdisj)
          (hρ.leaves_subset_allLeaves hbρ) (hσ.leaves_subset_allLeaves hb)
      have hHρb : Disjoint Hρ {b} := by
        apply Finset.disjoint_left.mpr
        intro q hq hbq
        simp only [Finset.mem_singleton] at hbq
        subst q
        exact (Finset.disjoint_left.mp hdisj) (hρsub hq)
          (hσ.leaves_subset_allLeaves hb)
      refine ⟨Hρ ∪ {b}, ?_, ?_, ?_, ?_⟩
      · intro q hq
        simp only [Finset.mem_union, Finset.mem_singleton] at hq
        rcases hq with hq | rfl
        · exact Finset.mem_union_left _ (hρsub hq)
        · exact Finset.mem_union_right _ (hσ.leaves_subset_allLeaves hb)
      · apply Finset.disjoint_left.mpr
        intro q hq hqP
        simp only [Finset.mem_union, Finset.mem_singleton] at hq
        rcases hq with hq | rfl
        · exact (Finset.disjoint_left.mp hρdisj) hq hqP
        · exact hb_not_hρ hqP
      · rw [Finset.card_union_of_disjoint hHρb, Finset.card_singleton,
          ChargeMergeHistory.keepCount, hρcard]
      · intro q hq
        simp only [Finset.mem_union, Finset.mem_singleton] at hq
        rcases hq with hq | rfl
        · exact hρnear q hq
        · have hxρ : x ∈ chargeSupport ρ :=
            hρ.good_site_mem_current hgρ hE ha hx
          refine ⟨y, hy, x, hxρ, ?_⟩
          calc
            latticeDistance boundary L y x = latticeDistance boundary L x y :=
              (latticeDistance_comm boundary L x y).symm
            _ ≤ 2 ^ k := hxy
  | @keepRight ρ σ hρ hσ hconflict hgρ hgσ hdisj ihρ ihσ =>
      obtain ⟨Hσ, hσsub, hσdisj, hσcard, hσnear⟩ := ihσ hE
      have hρSupport := hρ.good_support_eq_activeLeaves hgρ hE
      have hσSupport := hσ.good_support_eq_activeLeaves hgσ hE
      obtain ⟨a, ha, b, hb, x, hx, y, hy, hxy⟩ :=
        exists_conflicting_active_leaves boundary k ρ σ hρ.leaves hσ.leaves
          hρSupport hσSupport hρ.leaves_nonempty hσ.leaves_nonempty
          (by intro q hq; exact hE.1 q (hρ.allLeaves_subset
            (hρ.leaves_subset_allLeaves hq)))
          (by intro q hq; exact hE.1 q (hσ.allLeaves_subset
            (hσ.leaves_subset_allLeaves hq))) hconflict
      have hparentGood : (ChargeMergeHistory.keepRight hρ hσ hconflict).Good :=
        .keepRight hconflict hgρ hgσ hdisj
      have hparentSupport :=
        (ChargeMergeHistory.keepRight hρ hσ hconflict).good_support_eq_activeLeaves
          hparentGood hE
      have ha_not_hσ : a ∉ hσ.leaves := by
        intro haσ
        exact (Finset.disjoint_left.mp hdisj) (hρ.leaves_subset_allLeaves ha)
          (hσ.leaves_subset_allLeaves haσ)
      have hHσa : Disjoint Hσ {a} := by
        apply Finset.disjoint_left.mpr
        intro q hq haq
        simp only [Finset.mem_singleton] at haq
        subst q
        exact (Finset.disjoint_left.mp hdisj.symm) (hσsub hq)
          (hρ.leaves_subset_allLeaves ha)
      refine ⟨Hσ ∪ {a}, ?_, ?_, ?_, ?_⟩
      · intro q hq
        simp only [Finset.mem_union, Finset.mem_singleton] at hq
        rcases hq with hq | rfl
        · exact Finset.mem_union_right _ (hσsub hq)
        · exact Finset.mem_union_left _ (hρ.leaves_subset_allLeaves ha)
      · apply Finset.disjoint_left.mpr
        intro q hq hqP
        simp only [Finset.mem_union, Finset.mem_singleton] at hq
        rcases hq with hq | rfl
        · exact (Finset.disjoint_left.mp hσdisj) hq hqP
        · exact ha_not_hσ hqP
      · rw [Finset.card_union_of_disjoint hHσa, Finset.card_singleton,
          ChargeMergeHistory.keepCount, hσcard]
      · intro q hq
        simp only [Finset.mem_union, Finset.mem_singleton] at hq
        rcases hq with hq | rfl
        · exact hσnear q hq
        · have hyσ : y ∈ chargeSupport σ :=
            hσ.good_site_mem_current hgσ hE hb hy
          exact ⟨x, hx, y, hyσ, hxy⟩

/-- The carried history gives the exact iteration identity
`m = |P| - 1 + |H|`; every keep charge is a distinct input outside the final
lineage and lies within the selected conflict radius of the output factor. -/
theorem ChargeMergeHistory.good_lineage_keepChargeAccounting {L : ℕ}
    {boundary : SquareBoundary} {k : ℕ} {E : ChargeEnsemble L}
    {ρ : ChargeDensity L} (h : ChargeMergeHistory boundary k E ρ)
    (hg : h.Good) (hE : IsBKTEnsemble E) :
    ∃ H : ChargeEnsemble L,
      H ⊆ E ∧ Disjoint H h.leaves ∧
      h.multiplierCount = h.leaves.card - 1 + H.card ∧
      ∀ q ∈ H, densityDistance boundary L q ρ ≤ 2 ^ k := by
  obtain ⟨H, hHleaves, hHdisj, hHcard, hHnear⟩ :=
    h.exists_good_keepChargeSet hg hE
  have hleafCard := h.good_activeLeaves_card_eq_mergeCount_add_one hg
  refine ⟨H, hHleaves.trans h.allLeaves_subset, hHdisj, ?_, ?_⟩
  · rw [h.multiplierCount_eq_merge_add_keep, hHcard]
    omega
  · intro q hq
    obtain ⟨x, hx, y, hy, hxy⟩ := hHnear q hq
    calc
      densityDistance boundary L q ρ ≤ latticeDistance boundary L x y :=
        squareDistance_le_latticeDistance_of_mem boundary L
          (chargeSupport q) (chargeSupport ρ) x y hx hy
      _ ≤ 2 ^ k := hxy

/-- The recursive absolute coefficient generated by a merge history. -/
def ChargeMergeHistory.lineageMagnitude {L : ℕ} {boundary : SquareBoundary}
    {k : ℕ} {E : ChargeEnsemble L} {ρ : ChargeDensity L}
    (h : ChargeMergeHistory boundary k E ρ) (K : ChargeDensity L → ℝ) : ℝ :=
  match h with
  | .leaf ρ _ => |K ρ|
  | .add hρ hσ _ => 3 * hρ.lineageMagnitude K * hσ.lineageMagnitude K
  | .sub hρ hσ _ => 3 * hρ.lineageMagnitude K * hσ.lineageMagnitude K
  | .keepLeft hρ _ _ => 3 * hρ.lineageMagnitude K
  | .keepRight _ hσ _ => 3 * hσ.lineageMagnitude K

/-- The signed coefficient obtained by multiplying the input coefficients
along the active branch history. -/
def ChargeMergeHistory.lineageValue {L : ℕ} {boundary : SquareBoundary}
    {k : ℕ} {E : ChargeEnsemble L} {ρ : ChargeDensity L}
    (h : ChargeMergeHistory boundary k E ρ) (K : ChargeDensity L → ℝ) : ℝ :=
  match h with
  | .leaf ρ _ => K ρ
  | .add hρ hσ _ => 3 * hρ.lineageValue K * hσ.lineageValue K
  | .sub hρ hσ _ => 3 * hρ.lineageValue K * hσ.lineageValue K
  | .keepLeft hρ _ _ => 3 * hρ.lineageValue K
  | .keepRight _ hσ _ => 3 * hσ.lineageValue K

/-- Product of the input coefficient magnitudes on the active lineage. -/
def ChargeMergeHistory.activeLineageProduct {L : ℕ} {boundary : SquareBoundary}
    {k : ℕ} {E : ChargeEnsemble L} {ρ : ChargeDensity L}
    (h : ChargeMergeHistory boundary k E ρ) (K : ChargeDensity L → ℝ) : ℝ :=
  ∏ σ ∈ h.leaves, |K σ|

theorem ChargeMergeHistory.abs_lineageValue_eq_lineageMagnitude {L : ℕ}
    {boundary : SquareBoundary} {k : ℕ} {E : ChargeEnsemble L}
    {ρ : ChargeDensity L} (h : ChargeMergeHistory boundary k E ρ)
    (K : ChargeDensity L → ℝ) :
    |h.lineageValue K| = h.lineageMagnitude K := by
  induction h <;>
    simp [ChargeMergeHistory.lineageValue, ChargeMergeHistory.lineageMagnitude,
      *, abs_mul]

/-- The history multiplier and the active input factors exactly determine the
recursive magnitude, including the extra factors charged by keep steps. -/
theorem ChargeMergeHistory.lineageMagnitude_eq_multiplier_product {L : ℕ}
    {boundary : SquareBoundary} {k : ℕ} {E : ChargeEnsemble L}
    {ρ : ChargeDensity L} (h : ChargeMergeHistory boundary k E ρ)
    (hg : h.Good) (K : ChargeDensity L → ℝ) :
    h.lineageMagnitude K =
      (3 : ℝ) ^ h.multiplierCount * h.activeLineageProduct K := by
  induction hg with
  | leaf ρ hρ =>
      simp [ChargeMergeHistory.lineageMagnitude, ChargeMergeHistory.multiplierCount,
        ChargeMergeHistory.activeLineageProduct, ChargeMergeHistory.leaves]
  | @add ρ σ hρ hσ hconflict hgρ hgσ hdisj ihρ ihσ =>
      have hactive : Disjoint hρ.leaves hσ.leaves := by
        apply Finset.disjoint_left.mpr
        intro a ha hb
        exact (Finset.disjoint_left.mp hdisj)
          (hρ.leaves_subset_allLeaves ha) (hσ.leaves_subset_allLeaves hb)
      simp only [ChargeMergeHistory.lineageMagnitude, ChargeMergeHistory.multiplierCount,
        ChargeMergeHistory.activeLineageProduct, ChargeMergeHistory.leaves]
      rw [Finset.prod_union hactive, ihρ, ihσ, pow_add, pow_succ]
      simp only [ChargeMergeHistory.activeLineageProduct] at ihρ ihσ ⊢
      ring_nf
  | @sub ρ σ hρ hσ hconflict hgρ hgσ hdisj ihρ ihσ =>
      have hactive : Disjoint hρ.leaves hσ.leaves := by
        apply Finset.disjoint_left.mpr
        intro a ha hb
        exact (Finset.disjoint_left.mp hdisj)
          (hρ.leaves_subset_allLeaves ha) (hσ.leaves_subset_allLeaves hb)
      simp only [ChargeMergeHistory.lineageMagnitude, ChargeMergeHistory.multiplierCount,
        ChargeMergeHistory.activeLineageProduct, ChargeMergeHistory.leaves]
      rw [Finset.prod_union hactive, ihρ, ihσ, pow_add, pow_succ]
      simp only [ChargeMergeHistory.activeLineageProduct] at ihρ ihσ ⊢
      ring_nf
  | @keepLeft ρ σ hρ hσ hconflict hgρ hgσ hdisj ihρ ihσ =>
      simp only [ChargeMergeHistory.lineageMagnitude, ChargeMergeHistory.multiplierCount,
        ChargeMergeHistory.activeLineageProduct, ChargeMergeHistory.leaves]
      rw [ihρ, pow_succ]
      simp only [ChargeMergeHistory.activeLineageProduct] at ihρ ⊢
      ring_nf
  | @keepRight ρ σ hρ hσ hconflict hgρ hgσ hdisj ihρ ihσ =>
      simp only [ChargeMergeHistory.lineageMagnitude, ChargeMergeHistory.multiplierCount,
        ChargeMergeHistory.activeLineageProduct, ChargeMergeHistory.leaves]
      rw [ihσ, pow_succ]
      simp only [ChargeMergeHistory.activeLineageProduct] at ihσ ⊢
      ring_nf

/-- The coefficient itself is the multiplier power times the signed product
of the original input coefficients on the active lineage. -/
theorem ChargeMergeHistory.lineageValue_eq_multiplier_product {L : ℕ}
    {boundary : SquareBoundary} {k : ℕ} {E : ChargeEnsemble L}
    {ρ : ChargeDensity L} (h : ChargeMergeHistory boundary k E ρ)
    (hg : h.Good) (K : ChargeDensity L → ℝ) :
    h.lineageValue K =
      (3 : ℝ) ^ h.multiplierCount * ∏ σ ∈ h.leaves, K σ := by
  induction hg with
  | leaf ρ hρ =>
      simp [ChargeMergeHistory.lineageValue, ChargeMergeHistory.multiplierCount,
        ChargeMergeHistory.leaves]
  | @add ρ σ hρ hσ hconflict hgρ hgσ hdisj ihρ ihσ =>
      have hactive : Disjoint hρ.leaves hσ.leaves := by
        apply Finset.disjoint_left.mpr
        intro a ha hb
        exact (Finset.disjoint_left.mp hdisj)
          (hρ.leaves_subset_allLeaves ha) (hσ.leaves_subset_allLeaves hb)
      simp only [ChargeMergeHistory.lineageValue, ChargeMergeHistory.multiplierCount,
        ChargeMergeHistory.leaves]
      rw [Finset.prod_union hactive, ihρ, ihσ, pow_add, pow_succ]
      ring
  | @sub ρ σ hρ hσ hconflict hgρ hgσ hdisj ihρ ihσ =>
      have hactive : Disjoint hρ.leaves hσ.leaves := by
        apply Finset.disjoint_left.mpr
        intro a ha hb
        exact (Finset.disjoint_left.mp hdisj)
          (hρ.leaves_subset_allLeaves ha) (hσ.leaves_subset_allLeaves hb)
      simp only [ChargeMergeHistory.lineageValue, ChargeMergeHistory.multiplierCount,
        ChargeMergeHistory.leaves]
      rw [Finset.prod_union hactive, ihρ, ihσ, pow_add, pow_succ]
      ring
  | @keepLeft ρ σ hρ hσ hconflict hgρ hgσ hdisj ihρ ihσ =>
      simp only [ChargeMergeHistory.lineageValue, ChargeMergeHistory.multiplierCount,
        ChargeMergeHistory.leaves]
      rw [ihρ, pow_succ]
      ring
  | @keepRight ρ σ hρ hσ hconflict hgρ hgσ hdisj ihρ ihσ =>
      simp only [ChargeMergeHistory.lineageValue, ChargeMergeHistory.multiplierCount,
        ChargeMergeHistory.leaves]
      rw [ihσ, pow_succ]
      ring

/-- Substitution also commutes with the signed recursive lineage value. -/
theorem ChargeMergeHistory.lineageValue_substitute {L : ℕ}
    {boundary : SquareBoundary} {k : ℕ} {E F : ChargeEnsemble L}
    {ρ : ChargeDensity L} (replace : ∀ a ∈ F,
      CertifiedChargeMergeHistory boundary k E a)
    (h : ChargeMergeHistory boundary k F ρ) (K : ChargeDensity L → ℝ) :
    ChargeMergeHistory.lineageValue
        (ChargeMergeHistory.substitute (fun a ha => (replace a ha).history) h) K =
      h.lineageValue (fun a =>
        if ha : a ∈ F then (replace a ha).history.lineageValue K else 0) := by
  induction h with
  | leaf ρ hρ =>
      simp [ChargeMergeHistory.substitute, ChargeMergeHistory.lineageValue, hρ]
  | add hρ hσ hconflict ihρ ihσ =>
      simp [ChargeMergeHistory.substitute, ChargeMergeHistory.lineageValue, ihρ, ihσ]
  | sub hρ hσ hconflict ihρ ihσ =>
      simp [ChargeMergeHistory.substitute, ChargeMergeHistory.lineageValue, ihρ, ihσ]
  | keepLeft hρ hσ hconflict ihρ ihσ =>
      simp [ChargeMergeHistory.substitute, ChargeMergeHistory.lineageValue, ihρ]
  | keepRight hρ hσ hconflict ihρ ihσ =>
      simp [ChargeMergeHistory.substitute, ChargeMergeHistory.lineageValue, ihσ]

/-- The signed recursive lineage value only depends on the input coefficients
at the active leaves. -/
theorem ChargeMergeHistory.lineageValue_congr {L : ℕ}
    {boundary : SquareBoundary} {k : ℕ} {E : ChargeEnsemble L}
    {ρ : ChargeDensity L} (h : ChargeMergeHistory boundary k E ρ)
    (K K' : ChargeDensity L → ℝ)
    (hK : ∀ a ∈ h.leaves, K a = K' a) :
    h.lineageValue K = h.lineageValue K' := by
  induction h with
  | leaf ρ hρ =>
      change K ρ = K' ρ
      exact hK ρ (by simp [ChargeMergeHistory.leaves])
  | add hρ hσ hconflict ihρ ihσ =>
      have hρK : ∀ a ∈ hρ.leaves, K a = K' a := by
        intro a ha
        exact hK a (Finset.mem_union_left _ ha)
      have hσK : ∀ a ∈ hσ.leaves, K a = K' a := by
        intro a ha
        exact hK a (Finset.mem_union_right _ ha)
      simp [ChargeMergeHistory.lineageValue, ihρ hρK, ihσ hσK]
  | sub hρ hσ hconflict ihρ ihσ =>
      have hρK : ∀ a ∈ hρ.leaves, K a = K' a := by
        intro a ha
        exact hK a (Finset.mem_union_left _ ha)
      have hσK : ∀ a ∈ hσ.leaves, K a = K' a := by
        intro a ha
        exact hK a (Finset.mem_union_right _ ha)
      simp [ChargeMergeHistory.lineageValue, ihρ hρK, ihσ hσK]
  | keepLeft hρ hσ hconflict ihρ ihσ =>
      have hρK : ∀ a ∈ hρ.leaves, K a = K' a := by
        intro a ha
        exact hK a (by simp [ChargeMergeHistory.leaves, ha])
      simp [ChargeMergeHistory.lineageValue, ihρ hρK]
  | keepRight hρ hσ hconflict ihρ ihσ =>
      have hσK : ∀ a ∈ hσ.leaves, K a = K' a := by
        intro a ha
        exact hK a (by simp [ChargeMergeHistory.leaves, ha])
      simp [ChargeMergeHistory.lineageValue, ihσ hσK]

/-- Replacing the intermediate coefficients by their signed lineage products
preserves the value on the substituted history. -/
theorem ChargeMergeHistory.lineageValue_substitute_eq {L : ℕ}
    {boundary : SquareBoundary} {k : ℕ} {E F : ChargeEnsemble L}
    {ρ : ChargeDensity L} (replace : ∀ a ∈ F,
      CertifiedChargeMergeHistory boundary k E a)
    (h : ChargeMergeHistory boundary k F ρ) (K Kbranch : ChargeDensity L → ℝ)
    (hbranch : ∀ (a : ChargeDensity L) (ha : a ∈ h.leaves),
      Kbranch a = (replace a (h.leaves_subset ha)).history.lineageValue K) :
    ChargeMergeHistory.lineageValue
        (ChargeMergeHistory.substitute (fun a ha => (replace a ha).history) h) K =
      h.lineageValue Kbranch := by
  rw [h.lineageValue_substitute]
  apply h.lineageValue_congr
  intro a ha
  have hmem : a ∈ F := h.leaves_subset ha
  simp only [dite_eq_left hmem]
  exact (hbranch a ha).symm

